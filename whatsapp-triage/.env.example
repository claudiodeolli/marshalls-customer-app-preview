# JID do contato do cliente no WhatsApp. Descoberto uma vez rodando com
# BAILEYS_LOG_LEVEL=debug e olhando os JIDs que chegam, ou reaproveitando
# o já conhecido de configurações anteriores.
TRACKED_WA_JID=56414546436346@lid

# silent (padrão) | debug — debug ajuda a redescobrir um JID se o contato mudar.
BAILEYS_LOG_LEVEL=silent

# Token do GitHub (fine-grained PAT) com permissão "Issues: Read and write"
# neste repositório. O comando /whatsapp-issues exporta isso como GH_TOKEN
# antes de chamar o `gh` CLI — evita depender de `gh auth login` global.
GH_TOKEN=
